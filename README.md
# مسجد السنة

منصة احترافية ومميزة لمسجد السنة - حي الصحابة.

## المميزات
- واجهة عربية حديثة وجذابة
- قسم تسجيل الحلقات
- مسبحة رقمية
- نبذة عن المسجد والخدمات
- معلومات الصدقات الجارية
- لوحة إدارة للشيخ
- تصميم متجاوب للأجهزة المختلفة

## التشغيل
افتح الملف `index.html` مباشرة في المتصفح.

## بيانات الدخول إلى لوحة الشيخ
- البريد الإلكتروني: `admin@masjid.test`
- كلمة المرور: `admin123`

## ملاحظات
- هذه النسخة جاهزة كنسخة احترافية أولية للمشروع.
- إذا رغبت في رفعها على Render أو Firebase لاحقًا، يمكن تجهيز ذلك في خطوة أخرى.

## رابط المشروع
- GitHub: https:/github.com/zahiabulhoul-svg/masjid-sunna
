        <h3 style="margin:0 0 12px; color: var(--gold-2);">👨‍🎓 الطلاب</h3>
        <div id="studentsList" class="admin-list"></div>
      </div>

      <div style="margin-bottom: 22px;">
        <h3 style="margin:0 0 12px; color: var(--gold-2);">🤲 سجل صدقة جديدة</h3>
        <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px;">
          <div class="field">
