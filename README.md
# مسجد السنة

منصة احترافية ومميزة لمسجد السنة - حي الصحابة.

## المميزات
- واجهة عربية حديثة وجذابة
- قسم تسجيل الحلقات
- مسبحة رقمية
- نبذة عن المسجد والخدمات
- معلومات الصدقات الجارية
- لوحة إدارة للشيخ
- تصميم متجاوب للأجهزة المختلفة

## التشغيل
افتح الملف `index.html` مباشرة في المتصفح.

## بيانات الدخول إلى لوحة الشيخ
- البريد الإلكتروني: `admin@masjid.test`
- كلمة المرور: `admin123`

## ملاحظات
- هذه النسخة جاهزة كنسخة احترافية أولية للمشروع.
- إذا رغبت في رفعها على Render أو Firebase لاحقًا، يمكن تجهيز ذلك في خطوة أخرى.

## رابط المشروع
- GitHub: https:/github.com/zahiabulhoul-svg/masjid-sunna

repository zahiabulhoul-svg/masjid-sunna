        <button class="close-btn" onclick="closeDonationModal()" aria-label="إغلاق">×</button>
      </div>
      <div style="padding: 12px 6px; color: var(--muted); text-align: center;">
        شارك في دعم مسجد السنة واستدامة الخير في حي الصحابة.
      </div>
      <div style="display: grid; gap: 12px; margin-top: 16px;">
        <button class="btn btn-primary" onclick="location.href='https://wa.me/218913551819?text=السلام%20عليكم%20أريد%20التبرع%20لمسجد%20السنة'">💬 ��اتساب</button>
        <button class="btn btn-gold" onclick="copyText('2008291848')">📋 نسخ الحساب البنكي</button>
      </div>
    </div>
  </div>

  <script>
    const STORAGE_KEY = 'masjid_sunna_final_v1';
    const ADMIN_EMAIL = 'admin@masjid.test';
    const ADMIN_PASSWORD = 'admin123';

    let appState = JSON.parse(localStorage.getItem(STORAGE_KEY)) || {
      counter: 0,
      requests: [],
      students: [],
      donations: []
    };

    function saveState() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
    }

    function updateTotals() {
      document.getElementById('counterValue').textContent = appState.counter;
      const total = appState.donations.reduce((sum, item) => sum + Number(item.amount || 0), 0);
      document.getElementById('donationTotal').textContent = total;
      document.getElementById('donorCount').textContent = appState.donations.length;
    }

    function incrementCounter(step = 1) {
      appState.counter += step;
      saveState();
      updateTotals();
    }

    function resetCounter() {
      appState.counter = 0;
      saveState();
      updateTotals();
    }

    function scrollToSection(id) {
      const el = document.getElementById(id);
      if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function copyText(value) {
      navigator.clipboard.writeText(value).then(() => {
        alert('✅ تم نسخ: ' + value);
      }).catch(() => {
        alert('✅ ' + value);
      });
    }

    function showMessage(text, type) {
      const msg = document.getElementById('formMessage');
      msg.className = 'message ' + type;
      msg.textContent = text;
    }

    function handleRegistration(event) {
      event.preventDefault();
      const studentName = document.getElementById('studentName').value.trim();
      const parentPhone = document.getElementById('parentPhone').value.trim();
      const readType = document.getElementById('readType').value.trim();
      const timeSlot = document.getElementById('timeSlot').value.trim();
      const notes = document.getElementById('notes').value.trim();

      if (!studentName || !parentPhone || !readType || !timeSlot) {
        showMessage('يرجى تعبئة جميع الحقول المطلوبة.', 'error');
        return;
      }

      const request = {
        name: studentName,
        phone: parentPhone,
        readType,
        timeSlot,
        notes,
        createdAt: new Date().toISOString()
      };

      appState.requests.push(request);
      saveState();
      renderRequests();

      document.getElementById('regForm').reset();
      showMessage('✅ تم إرسال طلبك بنجاح، وسيتم التواصل معك قريبًا.', 'success');

      const whatsappText = encodeURIComponent(
        '🕌 طلب تسجيل - مسجد السنة\n' +
        'الاسم: ' + studentName + '\n' +
        'الهاتف: ' + parentPhone + '\n' +
        'الرواية: ' + readType + '\n' +
        'الفترة: ' + timeSlot + (notes ? '\nملاحظات: ' + notes : '')
      );

      window.open('https://wa.me/218913551819?text=' + whatsappText, '_blank');
    }

    function renderRequests() {
      const list = document.getElementById('requestsList');
      if (!list) return;

      if (!appState.requests.length) {
        list.innerHTML = '<div class="empty-note">لا توجد طلبات جديدة</div>';
        return;
      }

      list.innerHTML = appState.requests.map((req, index) => `
        <div class="list-item">
          <strong>${req.name}</strong><br />
          <small>${req.phone} | ${req.readType} | ${req.timeSlot}</small>
          <div class="list-actions">
            <button class="btn btn-primary" style="padding: 8px 12px; font-size: 12px;" onclick="acceptRequest(${index})">✅ قبول</button>
            <button class="btn btn-danger" style="padding: 8px 12px; font-size: 12px;" onclick="deleteRequest(${index})">🗑 حذف</button>
          </div>
        </div>
      `).join('');
    }

    function renderStudents() {
      const list = document.getElementById('studentsList');
      if (!list) return;

      if (!appState.students.length) {
        list.innerHTML = '<div class="empty-note">لا يوجد طلاب مسجلون</div>';
        return;
      }

      list.innerHTML = appState.students.map((name) => `
        <div class="list-item">✅ ${name}</div>
      `).join('');
    }

    function renderDonations() {
      const list = document.getElementById('donationsList');
      if (!list) return;

      if (!appState.donations.length) {
        list.innerHTML = '<div class="empty-note">لا توجد صدقات مسجلة</div>';
        return;
      }

      const total = appState.donations.reduce((sum, item) => sum + Number(item.amount || 0), 0);
      list.innerHTML = appState.donations.map((item) => `
        <div class="list-item">
          <strong>${item.name}</strong> - <span style="color: var(--gold-2); font-weight: 800;">${Number(item.amount || 0)} د.ل</span>
        </div>
      `).join('') + `<div class="list-item" style="background: rgba(15,122,79,0.14); border-color: rgba(217,178,66,0.2); margin-top: 10px;"><strong>المجموع:</strong> ${total} د.ل</div>`;
    }

    function acceptRequest(index) {
      const item = appState.requests[index];
      if (!item) return;
      appState.students.push(item.name);
      appState.requests.splice(index, 1);
      saveState();
      renderRequests();
      renderStudents();
    }

    function deleteRequest(index) {
      appState.requests.splice(index, 1);
      saveState();
      renderRequests();
    }

    function addDonation() {
      const name = document.getElementById('donorName').value.trim() || 'فاعل خير';
      const amount = Number(document.getElementById('donationAmount').value || 0);

      if (!amount || amount <= 0) {
        alert('أدخل مبلغًا صحيحًا');
        return;
      }

      appState.donations.push({ name, amount });
      saveState();
      updateTotals();
      renderDonations();
      document.getElementById('donorName').value = '';
      document.getElementById('donationAmount').value = '';
    }

    function openLoginModal() {
      document.getElementById('loginModal').classList.add('show');
    }

    function closeLoginModal() {
      document.getElementById('loginModal').classList.remove('show');
    }

    function openDonationModal() {
      document.getElementById('donationModal').classList.add('show');
    }

    function closeDonationModal() {
      document.getElementById('donationModal').classList.remove('show');
    }

    function openAdminModal() {
      document.getElementById('adminModal').classList.add('show');
      renderRequests();
      renderStudents();
      renderDonations();
    }

    function closeAdminModal() {
      document.getElementById('adminModal').classList.remove('show');
    }

    function handleAdminLogin() {
      const email = document.getElementById('adminEmail').value.trim();
      const pass = document.getElementById('adminPass').value.trim();

      if (email === ADMIN_EMAIL && pass === ADMIN_PASSWORD) {
        closeLoginModal();
        openAdminModal();
      } else {
        alert('❌ البريد أو كلمة المرور غير صحيحة');
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      updateTotals();
      renderRequests();
      renderStudents();
      renderDonations();

      document.getElementById('regForm').addEventListener('submit', handleRegistration);
    });
  </script>
</body>
